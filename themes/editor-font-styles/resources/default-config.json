// Built-in defaults of Editor Font Styles.
// A .editor-font-styles.json next to the document (or in a parent folder, or in %USERPROFILE%) is laid over
// these values: "styles" entries merge property by property ("name": null removes one), sections key by key.
{
  // .vssettings files whose Text Editor colors are applied without importing them; relative paths start at
  // the folder of the configuration file. Later files override items of earlier ones.
  "colors": [],

  // Font of the code editors, applied like "colors" without changing Fonts and Colors. The size is in points as in
  // Fonts and Colors; null keeps the family or size chosen there.
  "font": {
    "family": null,
    "size": null
  },

  // Keys are Fonts and Colors item names (as in .vssettings files) or classification names; * and ? match
  // any characters. Later entries win. Styles change fonts only; colors come from Fonts and Colors or "colors".
  "styles": {
    "*comment*": { "italic": true },
    "EditorFontStyles.SystemSymbol": { "italic": true },
    "EditorFontStyles.LocalSymbol": { "bold": true },
    "EditorFontStyles.CommentTag": { "bold": true },
    "EditorFontStyles.MatchedBrace": { "bold": true, "underline": true }
  },

  // C/C++: names declared by the standard library headers (Visual Assist "System symbols in italics").
  "systemSymbols": {
    "enabled": true,
    "extraNames": [],
    "excludeNames": []
  },

  // C/C++: names declared in the current file (Visual Assist "Local symbols in bold").
  "localSymbols": {
    "enabled": true
  },

  // C/C++: whole words inside comments.
  "commentTags": {
    "enabled": true,
    "words": [ "TODO", "FIXME", "HACK", "NOTE", "XXX", "BUG" ]
  },

  // C/C++: the bracket pair next to the caret, on either side of the bracket.
  "matchedBraces": {
    "enabled": true
  },

  // Extra folders for #include "..." besides the document's folder and the .vcxproj include directories;
  // relative paths start at the folder of the configuration file.
  "includeDirectories": [],

  // Write every Fonts and Colors item name to the Output window pane "Editor Font Styles".
  "listClassifications": false
}
